# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# ITAD API key (https://isthereanydeal.com/)
ITAD_API_KEY=your_itad_api_key_here
ITAD_CLIENT_ID=your_itad_client_id_here
ITAD_CLIENT_SECRET=your_itad_client_secret_here

# IGDB API credentials (https://api-docs.igdb.com/#account-creation)
# Created in the Twitch Developer Console with Client Type = Confidential.
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here
