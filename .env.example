# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# ITAD API key (https://isthereanydeal.com/)
ITAD_API_KEY=your_itad_api_key_here
ITAD_CLIENT_ID=your_itad_client_id_here
ITAD_CLIENT_SECRET=your_itad_client_secret_here

# RAWG API key (https://rawg.io/apidocs)
RAWG_API_KEY=your_rawg_api_key_here
